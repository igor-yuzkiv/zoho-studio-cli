{
    "extends": "@vue/tsconfig/tsconfig.dom.json",
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@web/*": ["./src/*"],
            "@cli/*": ["../cli/src/*"]
        },
        "types": ["vite/client"],
        "noUncheckedIndexedAccess": true
    },
    "include": ["src/**/*.ts", "src/**/*.vue"]
}
