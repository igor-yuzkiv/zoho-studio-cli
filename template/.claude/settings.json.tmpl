{
    "permissions": {
        "allow": [
            "Bash(zoho-studio instructions)",
            "Bash(zoho-studio instructions *)",
            "Bash(zoho-studio --help)",
            "Bash(zoho-studio * --help)"
        ],
        "ask": [
            "Bash(bun run scripts/*)",
            "Bash(bun run ./scripts/*)",
            "Bash(bun scripts/*)",
            "Bash(bun ./scripts/*)",
            "Bash(bun run migrate)",
            "Bash(bun run migrate *)"
        ],
        "deny": [
            "Read(**/.env)",
            "Read(**/.env.*)",
            "Read(~/.zoho-studio/profiles.json)",
            "Read(~/.zoho-studio/projects/**)",
            "Read(~/.ssh/**)"
        ]
    }
}
